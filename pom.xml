<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.sinaq</groupId>
  <artifactId>sinaq-api-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>Sinaq API Parent</name>
  <description>Sinaq — universal API automation framework. Parent build.</description>
  <url>https://github.com/xumoyun005/sinaq-api-java</url>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>xumoyun005</id>
      <name>Xumoyiddin Xolmuminov</name>
      <email>xumoyiddinxolmuminov858@gmail.com</email>
      <url>https://github.com/xumoyun005</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/xumoyun005/sinaq-api-java.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/xumoyun005/sinaq-api-java.git</developerConnection>
    <url>https://github.com/xumoyun005/sinaq-api-java</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/xumoyun005/sinaq-api-java/issues</url>
  </issueManagement>

  <modules>
    <module>sinaq-api-core</module>
    <module>sinaq-api-jdk</module>
    <module>sinaq-api-jackson</module>
    <module>sinaq-api-jsonpath</module>
    <module>sinaq-api-jsonschema</module>
    <module>sinaq-api-oauth</module>
    <module>sinaq-api-yaml</module>
    <module>sinaq-api-okhttp</module>
    <module>sinaq-api-jdbc</module>
    <module>sinaq-api-openapi</module>
    <module>sinaq-api-wiremock</module>
    <module>sinaq-api-restassured</module>
    <module>sinaq-api-testng</module>
    <module>sinaq-api-junit5</module>
    <module>sinaq-api-starter</module>
    <module>integration-tests</module>
    <module>examples</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <junit.version>5.10.2</junit.version>
    <assertj.version>3.25.3</assertj.version>

    <surefire.version>3.2.5</surefire.version>
    <enforcer.version>3.4.1</enforcer.version>
    <jacoco.version>0.8.12</jacoco.version>
    <source.plugin.version>3.3.1</source.plugin.version>
    <javadoc.plugin.version>3.11.2</javadoc.plugin.version>
    <gpg.plugin.version>3.2.7</gpg.plugin.version>
    <central.publishing.version>0.9.0</central.publishing.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-jdk</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-jackson</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-jsonpath</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-jsonschema</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-oauth</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-yaml</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-okhttp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-openapi</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-wiremock</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-restassured</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-testng</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.sinaq</groupId>
        <artifactId>sinaq-api-junit5</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${enforcer.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${source.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${javadoc.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>${gpg.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>${central.publishing.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-environment</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <failOnError>false</failOnError>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
